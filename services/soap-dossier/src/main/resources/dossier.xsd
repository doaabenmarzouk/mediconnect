<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://mediconnect.tn/soap/dossier"
           targetNamespace="http://mediconnect.tn/soap/dossier"
           elementFormDefault="qualified">

  <!-- ===== Types simples ===== -->

  <!-- Identifiant unique du patient (simulé : 8 chiffres) -->
  <xs:simpleType name="IdentifiantPatient">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Code d'acte en lettre-clé (exemples : C, CS, K50) -->
  <xs:simpleType name="CodeActe">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{1,3}[0-9]{0,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StatutFeuille">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EMISE"/>
      <xs:enumeration value="REJETEE"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== Types complexes ===== -->

  <xs:complexType name="ActeMedical">
    <xs:sequence>
      <xs:element name="numeroFeuille" type="xs:string"/>
      <xs:element name="dateActe" type="xs:date"/>
      <xs:element name="codeActe" type="tns:CodeActe"/>
      <xs:element name="libelle" type="xs:string"/>
      <xs:element name="montant" type="xs:decimal"/>
      <xs:element name="tauxRemboursement" type="xs:int"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Opération 1 : verifierDroitsCNAM ===== -->

  <xs:element name="VerifierDroitsCNAMRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="patientId" type="tns:IdentifiantPatient"/>
        <xs:element name="codeActe" type="tns:CodeActe"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="VerifierDroitsCNAMResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="droitsOuverts" type="xs:boolean"/>
        <!-- 80 ou 50 (0 si droits non ouverts) -->
        <xs:element name="tauxRemboursement" type="xs:int"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===== Opération 2 : emettreFeuilleDeSoins ===== -->

  <xs:element name="EmettreFeuilleDeSoinsRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="patientId" type="tns:IdentifiantPatient"/>
        <xs:element name="medecinId" type="xs:string"/>
        <xs:element name="codeActe" type="tns:CodeActe"/>
        <xs:element name="dateActe" type="xs:date"/>
        <xs:element name="montant" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="EmettreFeuilleDeSoinsResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numeroFeuille" type="xs:string"/>
        <xs:element name="statut" type="tns:StatutFeuille"/>
        <xs:element name="montantRembourse" type="xs:decimal"/>
        <xs:element name="resteACharge" type="xs:decimal"/>
        <xs:element name="dateEmission" type="xs:date"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===== Opération 3 : consulterHistorique ===== -->

  <xs:element name="ConsulterHistoriqueRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="patientId" type="tns:IdentifiantPatient"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ConsulterHistoriqueResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="patientId" type="tns:IdentifiantPatient"/>
        <xs:element name="actes" type="tns:ActeMedical" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>